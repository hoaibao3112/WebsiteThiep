// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// 1. USER & AUTHENTICATION (Multi-tenant)
// ---------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum AccountMemberRole {
  OWNER
  MEMBER
}

model Account {
  id                  String               @id @default(cuid())
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             AccountMember[]
  cards               Card[]
  cardEvents          CardEvent[]
  cardPhotos          CardPhoto[]
  guests              Guest[]
  rsvpResponses       RsvpResponse[]
  wishes              Wish[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]

  @@map("accounts")
}

model AccountMember {
  id        String            @id @default(cuid())
  accountId String
  userId    String
  role      AccountMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String? // Hash bcrypt cho email/password login
  name          String?
  phone         String?
  avatar        String?
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  role          Role     @default(USER)
  telegramId    String? // ID Telegram nhận thông báo RSVP realtime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cards          Card[]
  orders         Order[]
  accountMembers AccountMember[]

  @@map("users")
}

// ---------------------------------------------------------
// 2. PRICING & SUBSCRIPTION PLAN
// ---------------------------------------------------------
enum PlanCode {
  FREE
  BASIC
  VIP
}

model Plan {
  id                String   @id @default(cuid())
  code              PlanCode @unique
  name              String // Gói Miễn Phí / Gói Tiêu Chuẩn / Gói VIP
  price             Int // Giá tiền VND (0, 199000, 399000)
  durationDays      Int? // null = Vĩnh viễn, 7 = 7 ngày, 180 = 6 tháng
  maxPhotos         Int      @default(5)
  hasWatermark      Boolean  @default(true)
  allowCustomDomain Boolean  @default(false)
  allowMusicUpload  Boolean  @default(false)
  allowTelegramNoti Boolean  @default(false)
  features          Json? // Danh sách tính năng hiển thị
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cards  Card[]
  orders Order[]

  @@map("plans")
}

// ---------------------------------------------------------
// 3. TEMPLATE REPOSITORY
// ---------------------------------------------------------
enum CardCategory {
  WEDDING
  BIRTHDAY
  NEWBORN
}

model Template {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  category     CardCategory
  thumbnailUrl String
  previewUrl   String?
  configJson   Json // Cấu hình màu sắc, layout, font mặc định
  isPremium    Boolean      @default(false)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cards Card[]

  @@index([category, isActive])
  @@map("templates")
}

// ---------------------------------------------------------
// 4. CARD (CORE ENTITY)
// ---------------------------------------------------------
enum CardStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum OpeningEffect {
  NONE
  WAX_SEAL
  GATE_OPEN
  GIFT_BOX
}

enum FallingEffect {
  NONE
  PETAL
  HEART
  SNOW
  CONFETTI
  BALLOON
}

model Card {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  slug         String       @unique // VD: quan-va-ha-2026
  cardCategory CardCategory
  status       CardStatus   @default(DRAFT)

  // Quan hệ sở hữu & Gói dịch vụ
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  templateId String
  template   Template  @relation(fields: [templateId], references: [id])
  publishedAt         DateTime?
  expiredAt           DateTime? // Ngày hết hạn dựa theo Plan
  createIdempotencyKey String?

  // Cấu hình chung giao diện & hiệu ứng
  openingEffect   OpeningEffect @default(WAX_SEAL)
  fallingEffect   FallingEffect @default(PETAL)
  musicUrl        String?
  isAutoPlay      Boolean       @default(true)
  primaryColor    String        @default("#D4AF37") // Mã màu HEX
  fontFamily      String        @default("Inter")
  greetingMessage String? // Lời ngỏ chung

  // Payload dữ liệu riêng biệt theo Category (JSONB)
  categoryData Json

  // Cấu hình mừng cưới (Banking QR)
  bankingPrimary   Json? // { bankCode, accountNumber, accountName, qrUrl }
  bankingSecondary Json? // { bankCode, accountNumber, accountName, qrUrl } (Dành riêng cho cô dâu nếu là cưới)

  // Cấu hình nhận thông báo riêng cho thiệp
  telegramChatId String? // ID Telegram nhận thông báo RSVP của thiệp này

  viewCount Int @default(0) // Số lượt xem thiệp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ con
  events        CardEvent[]
  photos        CardPhoto[]
  guests        Guest[]
  rsvpResponses RsvpResponse[]
  wishes        Wish[]
  orders        Order[]

  @@index([userId])
  @@index([accountId])
  @@index([slug])
  @@index([cardCategory, status])
  @@unique([accountId, createIdempotencyKey])
  @@map("cards")
}

// ---------------------------------------------------------
// 5. CARD EVENT
// ---------------------------------------------------------
model CardEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  eventName String // VD: "Lễ Thành Hôn", "Tiệc Mừng Đầy Tháng", "Tiệc Sinh Nhật"
  eventDate DateTime // Ngày giờ diễn ra (Dương lịch)
  lunarDate String? // Ngày Âm lịch (VD: "Ngày 16 tháng 08 năm Giáp Thìn")
  venueName String // Tên địa điểm: "Tư gia nhà trai" hoặc "Trung tâm hội nghị GEM Center"
  address   String // Địa chỉ chi tiết
  mapUrl    String? // Link Google Maps
  latitude  Float?
  longitude Float?
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([accountId, cardId])
  @@map("card_events")
}

// ---------------------------------------------------------
// 6. PHOTO GALLERY
// ---------------------------------------------------------
model CardPhoto {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  url       String // Link ảnh trên CDN (Cloudinary / Supabase Storage / S3)
  thumbUrl  String? // Link thumbnail WebP siêu nhẹ
  caption   String?
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([accountId, cardId])
  @@map("card_photos")
}

// ---------------------------------------------------------
// 7. GUEST & PERSONALIZED LINK
// ---------------------------------------------------------
model Guest {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  guestCode  String // Legacy: giữ tạm để link cũ tiếp tục hoạt động
  guestToken String @unique
  fullName   String // Tên khách: "Nguyễn Văn Tuấn"
  normalizedName String
  normalizedPhone String?
  salutation String  @default("Bạn") // "Anh", "Chị", "Em", "Bác", "Gia đình"
  group      String? // "Bạn Cấp 3", "Đồng Nghiệp", "Họ Hàng"
  phone      String?
  customUrl  String? // /thiep/[slug]?g=G-8A9X
  notes      String?
  deliveryStatus GuestDeliveryStatus @default(NOT_SENT)
  shareOpenedAt DateTime?
  sentAt DateTime?

  rsvpResponses RsvpResponse[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cardId, guestCode])
  @@index([cardId])
  @@index([accountId, cardId])
  @@index([accountId, cardId, deliveryStatus])
  @@index([accountId, cardId, normalizedPhone])
  @@map("guests")
}

enum GuestDeliveryStatus {
  NOT_SENT
  OPENED_ZALO
  CONFIRMED_SENT
  FAILED
}

// ---------------------------------------------------------
// 8. RSVP RESPONSE
// ---------------------------------------------------------
enum RsvpStatus {
  ATTENDING
  DECLINED
  UNDECIDED
}

enum PartySide {
  GROOM_SIDE
  BRIDE_SIDE
  MUTUAL
}

model RsvpResponse {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  guestId   String?
  guest     Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)

  fullName   String
  phone      String?
  status     RsvpStatus @default(ATTENDING)
  guestCount Int        @default(1) // Số người tham gia (1, 2, 3...)
  side       PartySide  @default(MUTUAL)
  note       String? // Lời nhắn / Ăn chay / Yêu cầu đặc biệt

  ipAddress String? // Chống spam rate-limit
  userAgent String?

  createdAt DateTime @default(now())

  @@index([cardId, status])
  @@index([accountId, cardId, status])
  @@unique([cardId, guestId])
  @@map("rsvp_responses")
}

// ---------------------------------------------------------
// 9. WISHES & GUESTBOOK (Sổ lưu bút)
// ---------------------------------------------------------
model Wish {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  senderName   String
  relationship String? // "Bạn chú rể", "Đồng nghiệp cô dâu", "Bạn thân"...
  content      String  @db.Text
  emoji        String? // "❤️", "🥂", "🎉", "💐"
  isApproved   Boolean @default(true) // Hỗ trợ kiểm duyệt nếu cần
  ipAddress    String?

  createdAt DateTime @default(now())

  @@index([cardId, createdAt(sort: Desc)])
  @@index([accountId, cardId, createdAt(sort: Desc)])
  @@map("wishes")
}

// ---------------------------------------------------------
// 10. ORDER & PAYMENT (VietQR SePay Auto-Activation)
// ---------------------------------------------------------
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentGateway {
  VIETQR_SEPAY
  CASSO
  MANUAL
}

model Order {
  id               String  @id @default(cuid())
  accountId        String
  account          Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderCode        String  @unique // Mã đơn: "WD10982" (nội dung chuyển khoản)
  idempotencyKey   String
  pollingTokenHash String
  userId           String
  user             User    @relation(fields: [userId], references: [id])
  cardId           String
  card             Card    @relation(fields: [cardId], references: [id])
  planId           String
  plan             Plan    @relation(fields: [planId], references: [id])

  amount         Int // Số tiền phải thanh toán VND
  status         OrderStatus    @default(PENDING)
  paymentGateway PaymentGateway @default(VIETQR_SEPAY)
  paidAt         DateTime?
  expiredAt      DateTime // Hạn thanh toán (thường sau 30 phút tạo đơn)

  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, idempotencyKey])
  @@index([orderCode])
  @@index([userId])
  @@index([accountId, status])
  @@index([status])
  @@map("orders")
}

model PaymentTransaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gateway         PaymentGateway @default(VIETQR_SEPAY)
  gatewayTxId     String? // ID giao dịch từ SePay (để chống trùng lặp Webhook)
  amount          Int // Số tiền thực tế nhận được
  bankCode        String?
  accountNumber   String?
  transactionTime DateTime?
  rawPayload      Json // Lưu toàn bộ dữ liệu webhook trả về để audit

  createdAt DateTime @default(now())

  @@unique([gateway, gatewayTxId])
  @@index([orderId])
  @@index([accountId, orderId])
  @@map("payment_transactions")
}
